# Data — never commit dataset blobs. Regenerate via scripts/.
# Leading slash anchors this to the repo root: an unanchored `data/` would also
# match the `cliniverse/data/` and `twinbench/datasets/` source packages.
/data/

# Experiment outputs
runs/
outputs/
artifacts/
*.ckpt
*.pt
*.joblib

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Secrets — never commit credentials
.env
.env.*
!.env.example
*-key.json
*credentials*.json
service-account*.json

# Node / web
node_modules/
.next/
.vite/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
